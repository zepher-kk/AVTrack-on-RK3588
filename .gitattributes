# 文本统一 LF（在 Windows 上也不会被 CRLF 污染）
*        text=auto
*.sh     text eol=lf
*.py     text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.txt    text eol=lf
*.csv    text eol=lf
LICENSE  text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary

# 模型二进制默认不进仓库（走 GitHub Release）。
